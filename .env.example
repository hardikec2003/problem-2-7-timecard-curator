# Copy to .env and fill in what you use. Do not commit .env.

# Claude Code login for `claude -p`. Not an Anthropic API key.
# CLAUDE_KEY=

# Jibble free account: https://www.jibble.io/
# Organization settings → API credentials. Owner only.
# JIBBLE_CLIENT_ID=
# JIBBLE_CLIENT_SECRET=
# JIBBLE_API_BASE=https://time-tracking.prod.jibble.io

# Kimai open source: https://github.com/kimai/kimai
# KIMAI_BASE_URL=https://time.example.com
# KIMAI_API_TOKEN=

# Any other system that implements the roster and entries hooks.
# TIMECARD_HTTP_BASE=https://your-system.example/timecard
# TIMECARD_HTTP_TOKEN=

# Used when a person record has no manager address.
# TIMECARD_MANAGER_EMAIL=lead@example.com

# Slack incoming webhook, or any other HTTPS POST endpoint.
# NOTIFY_WEBHOOK_URL=

# SMTP. Port 587 uses STARTTLS. Port 465 uses SSL.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional copy of the payroll rows.
# PAYROLL_WEBHOOK_URL=
